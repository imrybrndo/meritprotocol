# ---------------------------------------------------------------- database --
# Two URLs to the same database, and they are not interchangeable.
#
# DATABASE_URL is what the running app uses: the transaction-mode pooler
# (Supabase port 6543, `?pgbouncer=true`). Serverless functions open far more
# connections than Postgres will accept, so the pooler is not optional there.
#
# DIRECT_URL is what migrations use — see prisma.config.ts. A session-scoped
# connection (Supabase port 5432). Migrations take a session advisory lock, and
# transaction pooling hands each statement a different backend, so against the
# 6543 URL `prisma migrate` hangs forever rather than failing.
#
# If the password contains any of  : / ? # [ ] @  it MUST be percent-encoded,
# or the URL parses wrongly and you get a connection error that looks like the
# server is down. And do replace the `[YOUR-PASSWORD]` placeholder that
# Supabase leaves in the string it gives you — that is the usual cause.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# --------------------------------------------------------------------- evm --
# The anchoring wallet. A private key, with or without the 0x prefix — a signing
# key, so it belongs in the environment and never in Git. It pays gas and holds
# no user funds.
EVM_ANCHOR_PRIVATE_KEY=

# Required alongside the key. There is no default: a guessed endpoint would mean
# anchoring to whatever chain the guess happened to hit. With the key set and
# this empty, the deployment logs the mistake and stays on the local adapter.
EVM_RPC_URL=

# Checked against what the RPC actually reports before the first write. A
# mismatch aborts rather than anchoring to an unexpected chain, so setting it is
# worth the one line.
EVM_CHAIN_ID=
# Label used in the `network` string and shown throughout the interface.
EVM_CHAIN_NAME=robinhood
# Base URL only; `/tx/<hash>` is appended. Without it anchors carry no link.
EVM_EXPLORER_URL=
# Blocks to wait for before an anchor is reported CONFIRMED. Default 1.
EVM_ANCHOR_CONFIRMATIONS=1

# --------------------------------------------------------------- scheduling --
# The scheduled routes seal batches and write reputation history, so they are
# not open: /api/cron/seal and /api/cron/reputation require
# `Authorization: Bearer $CRON_SECRET`. Vercel Cron sends this automatically
# once the variable is set on the project.
#
# Unset, the routes refuse to run in production rather than running for anyone
# who finds the URL. Generate one with:  openssl rand -hex 32
CRON_SECRET=

# When a batch gets sealed. Whichever condition is met first wins.
#
# A full 256-leaf batch is one anchor transaction for 256 commitments, which is
# as cheap as the protocol gets — but waiting for it is also how a quiet week
# leaves a decision unproven for days. So size is the efficiency trigger and age
# is the latency floor. Raise these to seal less often; the cron schedule only
# controls how often the question is asked, not the answer.
MERIT_SEAL_MIN_BATCH=32
MERIT_SEAL_MAX_AGE_MINUTES=60
# Hard ceiling on one Merkle tree. Cannot exceed 256.
MERIT_SEAL_MAX_BATCH=256

# ---------------------------------------------------------------- provenance --
# Source-repository scanning. Optional, but without it the GitHub API allows
# only 60 requests an hour, and each strategy version costs two — so the
# scheduled run caps itself at 20 versions rather than burning the budget and
# reporting the rest as UNREACHABLE, which would read as evidence against
# agents who did nothing wrong. A token raises the cap to 5000/hour.
#
# A read-only token with no scopes is enough: everything scanned is public.
GITHUB_TOKEN=

# ------------------------------------------------------------ rate limiting --
# Upstash Redis. Optional in development; without it rate limiting is a no-op.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ------------------------------------------------------------------ sdk/e2e --
# An API key issued by `npm run key:create`, used by the SDK example and tests.
MERIT_API_KEY=

# --------------------------------------------------------- desktop download --
# The landing page will not render a download button until it knows where a
# real artefact lives — see lib/desktop.ts. Disk images are excluded from the
# deployment (.vercelignore), so these must point off-site.
#
# The normal path: publish `desktop/release/MERIT-<version>-<arch>.dmg` as a
# GitHub release and set the tag here. Both architecture URLs are derived from
# it, so this one variable turns the download on.
MERIT_DESKTOP_RELEASE_TAG=v0.1.0

# Only if the artefacts live outside the default repository.
# MERIT_DESKTOP_RELEASE_REPO=imrybrndo/meritprotocol

# Only if an asset is hosted elsewhere or named off-pattern. An explicit URL
# overrides the derived one for that architecture, and must be absolute.
# MERIT_DESKTOP_MAC_ARM64_URL=
# MERIT_DESKTOP_MAC_X64_URL=

# The checksum is REQUIRED for a build to be offered. Without it the download
# button renders as "Not published", because a location an operator typed is not
# evidence a file exists, while a digest means somebody held the artefact and
# hashed it. Get one with:  shasum -a 256 desktop/release/MERIT-<v>-<arch>.dmg
#
# That still does not prove the file was uploaded. `npm run desktop:check` asks
# the host directly and exits non-zero if the site would offer a broken
# download; run it before every deploy that touches these variables.
MERIT_DESKTOP_MAC_ARM64_SIZE=121 MB
MERIT_DESKTOP_MAC_ARM64_SHA256=594fa5fb9ee5fa878d379c7eea3e6cbc7fd3c064fc913d86b7e0753ea70fba2c
MERIT_DESKTOP_MAC_X64_SIZE=126 MB
MERIT_DESKTOP_MAC_X64_SHA256=c2b6caa5a05d21f6d404deb1137977d7ee13944f9d3d15161237ca5d49053f03

# Defaults to the release tag's GitHub page when a tag is set.
# MERIT_DESKTOP_RELEASE_NOTES_URL=
